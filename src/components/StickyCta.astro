---
/**
 * Mobile-only sticky bottom CTA. Appears once the hero signup form has
 * scrolled out of view, disappears after the visitor subscribes (or if
 * they already did on a previous visit).
 */
---

<div class="sticky-cta" data-sticky-cta hidden>
  <a href="#zapis">Запиши се безплатно</a>
</div>

<style>
  .sticky-cta {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    padding: 10px 14px calc(10px + env(safe-area-inset-bottom));
    background: rgba(23, 21, 15, 0.9);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    transform: translateY(100%);
    transition: transform 0.25s ease;
  }

  .sticky-cta.visible {
    transform: translateY(0);
  }

  .sticky-cta[hidden] {
    display: none;
  }

  .sticky-cta a {
    display: block;
    text-align: center;
    text-decoration: none;
    color: #fff;
    font-weight: 700;
    font-size: 16px;
    padding: 14px 20px;
    border-radius: 13px;
    background: var(--grad);
    box-shadow: 0 10px 26px rgba(255, 78, 142, 0.4);
  }

  /* Desktop already has the always-visible header CTA. */
  @media (min-width: 761px) {
    .sticky-cta {
      display: none;
    }
  }
</style>

<script>
  const bar = document.querySelector('[data-sticky-cta]') as HTMLElement | null;
  const heroSignup = document.getElementById('zapis');

  if (bar && heroSignup) {
    let subscribed = false;
    try {
      subscribed = localStorage.getItem('vc_subscribed') === '1';
    } catch {
      /* ignore */
    }

    if (!subscribed) {
      bar.hidden = false;
      const observer = new IntersectionObserver(
        ([entry]) => {
          bar.classList.toggle('visible', !entry.isIntersecting);
        },
        { rootMargin: '80px 0px' }
      );
      observer.observe(heroSignup);

      document.addEventListener('vc:subscribed', () => {
        observer.disconnect();
        bar.hidden = true;
      });
    }
  }
</script>
