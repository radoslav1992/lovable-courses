---
/**
 * Email signup form. Rendered twice on the page (hero + final CTA);
 * a single shared script drives every instance.
 *
 * variant "dark"  — on the dark hero background (gradient button)
 * variant "light" — on the gradient CTA panel (white button)
 */
interface Props {
  variant: 'dark' | 'light';
  source: string;
}
const { variant, source } = Astro.props;
---

<div class={`signup ${variant}`} data-signup>
  <form data-signup-form novalidate>
    <input type="hidden" name="source" value={source} />
    <!-- Honeypot: invisible to humans, bots fill it in -->
    <div class="hp" aria-hidden="true">
      <label>Остави това поле празно <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
    </div>
    <div class="row">
      <label class="sr-only" for={`email-${source}`}>Имейл адрес</label>
      <input
        id={`email-${source}`}
        name="email"
        type="email"
        inputmode="email"
        enterkeyhint="go"
        autocomplete="email"
        placeholder="твоят@имейл.com"
        required
      />
      <button type="submit">
        <span class="btn-label">Запиши се безплатно</span>
        <span class="btn-busy" hidden>Записваме те…</span>
      </button>
    </div>
    <p class="err" data-signup-error hidden></p>
  </form>

  <div class="success" data-signup-success hidden>
    <span class="check" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="18" height="18">
        <path
          d="M5 12.5l4.2 4.2L19 7"
          fill="none"
          stroke="#fff"
          stroke-width="2.6"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </span>
    <div>
      <div class="success-title">Готово! Записан си. 🎉</div>
      <div class="success-sub">Изпращаме ти детайлите и линка на имейла.</div>
    </div>
  </div>
</div>

<style>
  .row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  input[type='email'] {
    flex: 1;
    min-width: 210px;
    border-radius: 13px;
    padding: 16px 18px;
    font-size: 16px;
    font-family: inherit;
    color: var(--ink);
  }

  button {
    border: none;
    cursor: pointer;
    font-family: inherit;
    font-weight: 700;
    font-size: 16px;
    padding: 16px 26px;
    border-radius: 13px;
    transition: transform 0.15s, box-shadow 0.15s;
  }

  button[disabled] {
    opacity: 0.75;
    cursor: wait;
  }

  .err {
    margin: 11px 2px 0;
    font-size: 14px;
    font-weight: 500;
  }

  .success[hidden] {
    display: none;
  }

  .success {
    display: flex;
    align-items: center;
    gap: 13px;
    border-radius: 14px;
    padding: 16px 18px;
    text-align: left;
  }

  .check {
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--violet), var(--blue));
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .success-title {
    font-weight: 700;
    font-size: 16px;
  }

  .success-sub {
    font-size: 14px;
  }

  /* --- dark variant (hero) --- */
  .dark input[type='email'] {
    background: #fff;
    border: 1px solid transparent;
  }

  .dark input[type='email']:focus {
    border-color: var(--pink);
    outline: none;
  }

  .dark button {
    color: #fff;
    background: var(--grad);
    box-shadow: 0 10px 26px rgba(255, 78, 142, 0.4);
  }

  .dark button:hover:not([disabled]) {
    transform: translateY(-2px);
    box-shadow: 0 14px 30px rgba(255, 78, 142, 0.5);
  }

  .dark .err {
    color: #ff9aa8;
  }

  .dark .success {
    background: rgba(75, 115, 255, 0.14);
    border: 1px solid rgba(124, 92, 255, 0.4);
    color: #fff;
  }

  .dark .success-sub {
    color: var(--muted-dark);
  }

  /* --- light variant (gradient CTA panel) --- */
  .light .row {
    justify-content: center;
  }

  .light input[type='email'] {
    min-width: 220px;
    background: rgba(255, 255, 255, 0.96);
    border: 2px solid transparent;
  }

  .light input[type='email']:focus {
    border-color: var(--ink);
    outline: none;
  }

  .light button {
    color: var(--ink);
    background: #fff;
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.18);
  }

  .light button:hover:not([disabled]) {
    transform: translateY(-2px);
  }

  .light .err {
    color: #fff;
    font-weight: 600;
    text-align: center;
  }

  .light .success {
    background: rgba(255, 255, 255, 0.16);
    border: 1px solid rgba(255, 255, 255, 0.4);
    color: #fff;
  }

  .light .success-sub {
    color: rgba(255, 255, 255, 0.85);
  }
</style>

<script>
  const STORAGE_KEY = 'vc_subscribed';
  const UTM_KEY = 'vc_utm';

  // Capture UTM params on first landing and keep them for the whole visit,
  // so attribution survives even if the visitor navigates around first.
  function getAttribution(): Record<string, string> {
    let stored: Record<string, string> = {};
    try {
      stored = JSON.parse(sessionStorage.getItem(UTM_KEY) || '{}');
    } catch {
      /* ignore */
    }
    const params = new URLSearchParams(location.search);
    for (const k of ['utm_source', 'utm_medium', 'utm_campaign']) {
      const v = params.get(k);
      if (v && !stored[k]) stored[k] = v;
    }
    if (!stored.referrer && document.referrer && !document.referrer.startsWith(location.origin)) {
      stored.referrer = document.referrer;
    }
    try {
      sessionStorage.setItem(UTM_KEY, JSON.stringify(stored));
    } catch {
      /* ignore */
    }
    return stored;
  }

  const attribution = getAttribution();

  function showSuccess(root: Element) {
    root.querySelector('form')?.setAttribute('hidden', '');
    root.querySelector('[data-signup-success]')?.removeAttribute('hidden');
  }

  function markAllSubscribed() {
    try {
      localStorage.setItem(STORAGE_KEY, '1');
    } catch {
      /* private mode etc. */
    }
    document.querySelectorAll('[data-signup]').forEach(showSuccess);
    // Lets other UI (e.g. the sticky mobile CTA) react to the signup.
    document.dispatchEvent(new CustomEvent('vc:subscribed'));
  }

  // Returning visitor who already signed up: skip straight to the success state.
  try {
    if (localStorage.getItem(STORAGE_KEY) === '1') {
      document.querySelectorAll('[data-signup]').forEach(showSuccess);
    }
  } catch {
    /* ignore */
  }

  document.querySelectorAll<HTMLFormElement>('[data-signup-form]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const emailInput = form.elements.namedItem('email') as HTMLInputElement;
      const email = emailInput.value.trim();
      const errEl = form.querySelector('[data-signup-error]') as HTMLElement;
      const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const label = button.querySelector('.btn-label') as HTMLElement;
      const busy = button.querySelector('.btn-busy') as HTMLElement;

      errEl.hidden = true;

      if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
        errEl.textContent = 'Моля, въведи валиден имейл адрес.';
        errEl.hidden = false;
        emailInput.focus();
        return;
      }

      button.disabled = true;
      label.hidden = true;
      busy.hidden = false;

      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email,
            source: (form.elements.namedItem('source') as HTMLInputElement).value,
            website: (form.elements.namedItem('website') as HTMLInputElement).value,
            ...attribution,
          }),
        });
        const data = (await res.json()) as { ok?: boolean; error?: string };
        if (res.ok && data.ok) {
          markAllSubscribed();
        } else {
          errEl.textContent =
            data.error || 'Нещо се обърка. Опитай отново или ни пиши на имейла.';
          errEl.hidden = false;
        }
      } catch {
        errEl.textContent = 'Няма връзка със сървъра. Провери интернета си и опитай пак.';
        errEl.hidden = false;
      } finally {
        button.disabled = false;
        label.hidden = false;
        busy.hidden = true;
      }
    });
  });
</script>
