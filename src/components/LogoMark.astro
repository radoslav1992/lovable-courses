---
interface Props {
  size?: number;
  radius?: number;
}
const { size = 38, radius = 12 } = Astro.props;
const icon = Math.round(size * 0.55);
---

<span
  class="logo-mark"
  style={`width:${size}px;height:${size}px;border-radius:${radius}px`}
  aria-hidden="true"
>
  <svg viewBox="0 0 28 28" width={icon} height={icon} aria-hidden="true">
    <path
      d="M3.5 17.5c2.6 0 2.6-7 5.2-7s2.6 7 5.2 7 2.6-7 5.2-7 2.6 7 5.2 7"
      fill="none"
      stroke="#fff"
      stroke-width="2.5"
      stroke-linecap="round"></path>
  </svg>
</span>

<style>
  .logo-mark {
    flex: none;
    background: var(--grad-full);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 18px rgba(255, 78, 142, 0.35);
  }
</style>
