---
/**
 * The official Lovable heart mark (from the brand asset the mark was
 * exported at 1883×1920; served as a 126×128 webp — the badges show it
 * at 22–26px).
 */
interface Props {
  size: number;
}
const { size } = Astro.props;
const width = Math.round((size * 126) / 128);
---

<img
  src="/assets/lovable-heart.webp"
  width={width}
  height={size}
  alt=""
  aria-hidden="true"
  loading="lazy"
  decoding="async"
/>
