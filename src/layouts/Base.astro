---
import { siteConfig } from '../config';
import ConsentBanner from '../components/ConsentBanner.astro';

interface Props {
  title: string;
  description: string;
  /** Path of the current page, used for canonical + og:url */
  path?: string;
  /** Keep the page out of search results (e.g. the bonus page). */
  noindex?: boolean;
  /**
   * Ad conversion event fired on this page once tracking is consented
   * and loaded (e.g. "lead" on the thank-you page).
   */
  conversionEvent?: string;
}

const { title, description, path = '/', noindex = false, conversionEvent } = Astro.props;
const canonical = new URL(path, Astro.site);
const ogImage = new URL('/og.jpg', Astro.site);
const hasTracking = Boolean(siteConfig.fbPixelId || siteConfig.googleTagId);
---

<!doctype html>
<html lang="bg">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta name="theme-color" content="#17150F" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Vibe Coding с Lovable" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta
      property="og:image:alt"
      content="Вайб коудинг с Lovable — безплатен уебинар на живо, 1 час. Бонус: 10 готови промпта за Lovable."
    />
    <meta property="og:locale" content="bg_BG" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Onest is self-hosted (variable 400–800): removes the Google Fonts
         round-trip and the GDPR exposure of remote font loading. -->
    <link
      rel="preload"
      href="/fonts/onest-cyrillic.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href="/fonts/onest-latin.woff2" as="font" type="font/woff2" crossorigin />

    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {
      siteConfig.cfBeaconToken && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: siteConfig.cfBeaconToken })}
        />
      )
    }
  </head>
  <body data-conversion={conversionEvent}>
    <slot />
    {hasTracking && <ConsentBanner />}
  </body>
</html>

<style is:global>
  /* cyrillic-ext */
  @font-face {
    font-family: 'Onest';
    font-style: normal;
    font-weight: 400 800;
    font-display: swap;
    src: url('/fonts/onest-cyrillic-ext.woff2') format('woff2');
    unicode-range: U+0460-052F, U+1C80-1C8A, U+20B4, U+2DE0-2DFF, U+A640-A69F, U+FE2E-FE2F;
  }
  /* cyrillic */
  @font-face {
    font-family: 'Onest';
    font-style: normal;
    font-weight: 400 800;
    font-display: swap;
    src: url('/fonts/onest-cyrillic.woff2') format('woff2');
    unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
  }
  /* latin-ext */
  @font-face {
    font-family: 'Onest';
    font-style: normal;
    font-weight: 400 800;
    font-display: swap;
    src: url('/fonts/onest-latin-ext.woff2') format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304,
      U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0,
      U+2113, U+2C60-2C7F, U+A720-A7FF;
  }
  /* latin */
  @font-face {
    font-family: 'Onest';
    font-style: normal;
    font-weight: 400 800;
    font-display: swap;
    src: url('/fonts/onest-latin.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304,
      U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  :root {
    --ink: #17150f;
    --paper: #fcfbf8;
    --muted-dark: #c9c4b8;
    --muted-dark-2: #b0aa9d;
    --muted-light: #6b6656;
    --orange: #fe7b02;
    --pink: #ff4e8e;
    --pink-soft: #ff8fb5;
    --violet: #7c5cff;
    --blue: #4b73ff;
    --grad: linear-gradient(115deg, #fe7b02, #ff4e8e 55%, #7c5cff);
    --grad-full: linear-gradient(135deg, #fe7b02, #ff4e8e 45%, #7c5cff 72%, #4b73ff);
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    font-family: 'Onest', system-ui, sans-serif;
    background: var(--ink);
    color: var(--ink);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  ::selection {
    background: var(--pink);
    color: #fff;
  }

  input::placeholder {
    color: #9c968a;
  }

  [id] {
    scroll-margin-top: 80px;
  }

  @keyframes floaty {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-14px);
    }
  }

  @keyframes spin-slow {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
