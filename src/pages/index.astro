---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SignupForm from '../components/SignupForm.astro';
import StickyCta from '../components/StickyCta.astro';
import { siteConfig } from '../config';

const nextSessionDate = siteConfig.nextSessionDate;

// TODO(radoslav): PLACEHOLDER testimonials — replace with real quotes
// (and get permission from the people quoted) before launch.
const testimonials = [
  {
    quote:
      'Мислех, че „да си направя приложение“ е за програмисти. Час по-късно имах работещ прототип, който показах на клиент още същата вечер.',
    name: 'Име Фамилия',
    role: 'Маркетинг специалист',
    initials: 'ИФ',
  },
  {
    quote:
      'Най-полезното беше да гледам как Радо мисли, докато строи. Промптовете, които показа, ги ползвам всеки ден.',
    name: 'Име Фамилия',
    role: 'Основател на малък бизнес',
    initials: 'ИФ',
  },
  {
    quote:
      'Без нито един ред код си направих вътрешен инструмент, за който агенция ми искаше няколко хиляди лева.',
    name: 'Име Фамилия',
    role: 'Консултант',
    initials: 'ИФ',
  },
];

const faqs = [
  {
    q: 'Трябва ли ми опит в програмиране?',
    a: 'Не. Целият курс е създаден точно за хора без опит в кода. Описваш какво искаш на естествен език, а Lovable върши тежката работа.',
  },
  {
    q: 'Колко струва?',
    a: 'Първият уебинар е напълно безплатен. По-късно ще предложа задълбочени платени курсове, но безплатният е самостоятелен и завършен сам по себе си.',
  },
  {
    q: 'Кога е следващата сесия?',
    a: `Следваща сесия: ${nextSessionDate}. Щом се запишеш, получаваш точната дата, час и линк директно на имейла си.`,
  },
  {
    q: 'Ще има ли запис?',
    a: 'Да. Ако не можеш да присъстваш на живо, изпращаме пълен запис на всички записали се.',
  },
  {
    q: 'Свързани ли сте с Lovable?',
    a: 'Не. Този курс е напълно независим и не е официално свързан, спонсориран или одобрен от Lovable. „Lovable“ е търговска марка на съответния собственик и се споменава тук само защото курсът учи как да се работи с инструмента.',
  },
];

// Structured data: FAQ rich results + entities (site, course, lecturer)
// that search and answer engines can attribute correctly.
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', Astro.site).href,
      url: Astro.site?.href,
      name: 'Vibe Coding с Lovable',
      inLanguage: 'bg',
    },
    {
      '@type': 'Person',
      '@id': new URL('/#lektor', Astro.site).href,
      name: 'Радослав Додников',
      url: Astro.site?.href,
      sameAs: ['https://www.linkedin.com/in/radoslav-dodnikov'],
      jobTitle: 'Лектор, Vibe Coding с Lovable',
    },
    {
      '@type': 'Course',
      name: 'Вайб коудинг с Lovable — безплатен уебинар',
      description:
        'Едночасов уебинар на живо на български: как да създаваш работещи уеб приложения без опит в програмирането, чрез вайб коудинг с Lovable. Независим курс, несвързан с Lovable.',
      inLanguage: 'bg',
      isAccessibleForFree: true,
      provider: { '@id': new URL('/#lektor', Astro.site).href },
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'BGN',
        availability: 'https://schema.org/InStock',
      },
      hasCourseInstance: {
        '@type': 'CourseInstance',
        courseMode: 'Online',
        courseWorkload: 'PT1H',
      },
    },
  ],
});
---

<Base
  title="Вайб коудинг с Lovable — безплатен уебинар на живо"
  description="Научи как да превръщаш идеи в работещи приложения без опит в програмиране. Безплатен 1-часов уебинар на живо с Радослав Додников — топ 10% Lovable потребител."
  path="/"
>
  <script type="application/ld+json" set:html={jsonLd} />

  <div class="page">
    <Header />

    <!-- ============ HERO ============ -->
    <section id="top" class="hero">
      <div class="glow glow-tr" aria-hidden="true"></div>
      <div class="glow glow-bl" aria-hidden="true"></div>

      <div class="hero-grid">
        <div>
          <div class="live-pill">
            <span class="live-dot" aria-hidden="true"></span>
            Безплатен уебинар на живо · 1 час
          </div>
          <h1>
            Вайб коудинг<br />с <span class="grad-text">Lovable</span>
          </h1>
          <p class="hero-sub">
            Научи как да превръщаш идеи в работещи приложения — <strong
              >без опит в програмиране</strong
            >. Един час на живо, който ще промени начина, по който създаваш.
          </p>

          <div id="zapis" class="hero-signup">
            <SignupForm variant="dark" source="hero" />
            <p class="bonus-line">
              🎁 Бонус при записване: <strong>{siteConfig.leadMagnetTitle}</strong> — веднага на
              имейла ти.
            </p>
            <p class="fine-print">
              Без спам. Отписваш се по всяко време. · <a href="#faq">Не сме свързани с Lovable</a>
            </p>
          </div>
        </div>

        <div class="hero-visual">
          <div class="orb" aria-hidden="true"></div>
          <div class="orbit" aria-hidden="true"></div>
          <img
            src="/assets/radoslav-cutout.webp"
            alt="Радослав Додников"
            width="880"
            height="880"
            fetchpriority="high"
          />
          <div class="badge-float">
            <span class="badge-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22">
                <defs>
                  <linearGradient id="hh1" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0" stop-color="#FE7B02"></stop>
                    <stop offset=".5" stop-color="#FF4E8E"></stop>
                    <stop offset="1" stop-color="#4B73FF"></stop>
                  </linearGradient>
                </defs>
                <path
                  d="M12 20.5S4.6 15.8 4.6 10.6A3.9 3.9 0 0 1 12 8.2a3.9 3.9 0 0 1 7.4 2.4c0 5.2-7.4 9.9-7.4 9.9z"
                  fill="url(#hh1)"></path>
              </svg>
            </span>
            <div>
              <div class="badge-kicker">TOP 10%</div>
              <div class="badge-title">Lovable потребител</div>
            </div>
          </div>
        </div>
      </div>

      <div class="stats">
        <div class="stat">
          <div class="stat-num">1 час</div>
          <div class="stat-sub">на живо, концентрирано</div>
        </div>
        <div class="stat">
          <div class="stat-num">0 реда код</div>
          <div class="stat-sub">описваш с думи, AI строи</div>
        </div>
        <div class="stat">
          <div class="stat-num">Общност</div>
          <div class="stat-sub">Discord / Telegram достъп</div>
        </div>
      </div>
    </section>

    <!-- ============ КУРСЪТ ============ -->
    <section id="kurs" class="course">
      <div class="container">
        <div class="section-head">
          <div class="kicker">Какво ще научиш</div>
          <h2>Три въпроса. Един час.<br />Напълно нов начин да строиш.</h2>
        </div>
        <div class="cards">
          <div class="card card-1">
            <div class="card-num n1">1</div>
            <h3>Какво е вайб коудинг?</h3>
            <p>
              Новият начин да създаваш софтуер — като описваш какво искаш на естествен език. AI
              пише кода, ти водиш посоката.
            </p>
          </div>
          <div class="card card-2">
            <div class="card-num n2">2</div>
            <h3>Защо Lovable?</h3>
            <p>
              Инструментът, който превръща текст в пълноценни уеб приложения за минути. Ще видиш
              на живо защо е любимец на създателите.
            </p>
          </div>
          <div class="card card-3">
            <div class="card-num n3">3</div>
            <h3>Какво можем да създадем?</h3>
            <p>
              От лендинг страници и вътрешни инструменти до AI чатботове и стартъп MVP-та. Стъпка
              по стъпка, от нула до готово.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ ФОРМАТ ============ -->
    <section class="format">
      <div class="container format-grid">
        <div>
          <div class="kicker pink">Как протича</div>
          <h2>Живо, практично<br />и без заучени лекции.</h2>
          <p class="format-sub">
            Показвам всичко на екрана в реално време. Задаваш въпроси, строим заедно, а след това
            оставаш в общността, за да продължиш.
          </p>
          <a href="#zapis" class="btn-light">Запази мястото си →</a>
        </div>
        <div class="format-list">
          <div class="format-item">
            <span class="format-emoji" aria-hidden="true">🎥</span>
            <div>
              <div class="fi-title">Живи сесии и уебинари</div>
              <div class="fi-sub">Всичко на живо, с демонстрации и въпроси в реално време.</div>
            </div>
          </div>
          <div class="format-item">
            <span class="format-emoji" aria-hidden="true">💬</span>
            <div>
              <div class="fi-title">Общност в Discord / Telegram</div>
              <div class="fi-sub">Продължаваш да питаш и да споделяш проекти и след сесията.</div>
            </div>
          </div>
          <div class="format-item">
            <span class="format-emoji" aria-hidden="true">📼</span>
            <div>
              <div class="fi-title">Запис за записалите се</div>
              <div class="fi-sub">Ако пропуснеш на живо — получаваш пълния запис.</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ ЛЕКТОР ============ -->
    <section id="lektor" class="lektor">
      <div class="container lektor-grid">
        <div class="lektor-photo">
          <div class="photo-back" aria-hidden="true"></div>
          <img
            src="/assets/radoslav-office.webp"
            alt="Радослав Додников"
            width="1200"
            height="675"
            loading="lazy"
          />
        </div>
        <div>
          <div class="kicker">Твоят лектор</div>
          <h2>Радослав Додников</h2>
          <p class="lektor-bio">
            Създател, който вярва, че всеки може да изгражда софтуер. Класиран съм в <strong
              >топ 10% от потребителите на Lovable</strong
            >, където изграждам AI чатботове, prompt-базирани инструменти и приложения с машинно
            обучение. В този курс споделям всичко научено — на прост и практичен език, без излишен
            жаргон.
          </p>

          <div class="lovable-card">
            <div class="lc-head">
              <span class="lc-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="26" height="26">
                  <defs>
                    <linearGradient id="hh2" x1="0" y1="0" x2="1" y2="1">
                      <stop offset="0" stop-color="#FE7B02"></stop>
                      <stop offset=".5" stop-color="#FF4E8E"></stop>
                      <stop offset="1" stop-color="#4B73FF"></stop>
                    </linearGradient>
                  </defs>
                  <path
                    d="M12 20.5S4.6 15.8 4.6 10.6A3.9 3.9 0 0 1 12 8.2a3.9 3.9 0 0 1 7.4 2.4c0 5.2-7.4 9.9-7.4 9.9z"
                    fill="url(#hh2)"></path>
                </svg>
              </span>
              <div>
                <div class="lc-name">Lovable</div>
                <div class="lc-sub">Conversational AI Software</div>
              </div>
              <span class="lc-badge">Top 10%</span>
            </div>
            <div class="lc-body">
              <div class="lc-title">Топ потребител</div>
              <div class="lc-text">Радослав е класиран в топ 10% от потребителите на Lovable.</div>
              <div class="lc-note">Обобщено от Lovable спрямо активността в приложението.</div>
            </div>
          </div>

          <div class="lektor-actions">
            <a
              href="https://www.linkedin.com/in/radoslav-dodnikov"
              target="_blank"
              rel="noopener"
              class="btn-dark"
            >
              <svg viewBox="0 0 24 24" width="18" height="18" fill="#fff" aria-hidden="true">
                <path
                  d="M4.98 3.5A2.5 2.5 0 1 0 5 8.5a2.5 2.5 0 0 0-.02-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05C20.3 8.65 21 11 21 14.1V21h-4v-6.1c0-1.45-.03-3.3-2-3.3s-2.3 1.57-2.3 3.2V21H9z"
                ></path>
              </svg>
              LinkedIn профил
            </a>
            <a href="mailto:radoslav.dodnikov@gmail.com" class="btn-outline">Пиши ми</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ ОТЗИВИ ============ -->
    <section id="otzivi" class="otzivi">
      <div class="container">
        <div class="section-head centered">
          <div class="kicker">Какво казват участниците</div>
          <h2>Хора без опит в кода.<br />Реални резултати.</h2>
        </div>
        <div class="quotes">
          {
            testimonials.map((t) => (
              <figure class="quote-card">
                <blockquote>„{t.quote}“</blockquote>
                <figcaption>
                  <span class="avatar" aria-hidden="true">
                    {t.initials}
                  </span>
                  <span>
                    <span class="q-name">{t.name}</span>
                    <span class="q-role">{t.role}</span>
                  </span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ СКОРО ============ -->
    <section id="skoro" class="soon">
      <div class="glow glow-soon" aria-hidden="true"></div>
      <div class="container">
        <div class="section-head">
          <div class="soon-pill">🔒 Скоро</div>
          <h2>След безплатния — задълбочените платени курсове.</h2>
          <p class="soon-sub">
            Безплатният уебинар е само началото. Подготвям пълни програми за тези, които искат да
            стигнат до реален продукт. Запиши се сега и ще си първи, когато стартират.
          </p>
        </div>
        <div class="modules">
          <div class="module">
            <div class="module-kicker">МОДУЛ 01</div>
            <h3>От идея до SaaS</h3>
            <p>Пълен продукт с логин, база данни и плащания — изцяло с Lovable.</p>
          </div>
          <div class="module">
            <div class="module-kicker">МОДУЛ 02</div>
            <h3>AI агенти и автоматизации</h3>
            <p>Свързваш модели, API-та и работни потоци в реални бизнес инструменти.</p>
          </div>
          <div class="module">
            <div class="module-kicker">МОДУЛ 03</div>
            <h3>Пусни и продавай</h3>
            <p>Домейн, дизайн, маркетинг и първите ти реални потребители.</p>
          </div>
        </div>
        <div class="soon-cta">
          <a href="#zapis" class="btn-light">Запиши се и научи първи →</a>
        </div>
      </div>
    </section>

    <!-- ============ FAQ ============ -->
    <section id="faq" class="faq">
      <div class="faq-inner">
        <h2>Често задавани въпроси</h2>
        <div class="faq-list">
          {
            faqs.map((f, i) => (
              <details name="faq" open={i === 0}>
                <summary>
                  <span>{f.q}</span>
                  <span class="faq-sign" aria-hidden="true" />
                </summary>
                <div class="faq-answer">{f.a}</div>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ FINAL CTA ============ -->
    <section class="final">
      <div class="final-panel">
        <div class="final-blob" aria-hidden="true"></div>
        <div class="final-content">
          <h2>Готов ли си да строиш?</h2>
          <p>
            Запиши се за безплатния уебинар и получи линка и материалите директно на имейла си.
          </p>
          <div class="final-form">
            <SignupForm variant="light" source="final-cta" />
            <p class="final-bonus">
              🎁 Бонус: <strong>{siteConfig.leadMagnetTitle}</strong> — веднага след записване.
            </p>
            <p class="final-fine">
              Този курс е независим и не е официално свързан, спонсориран или одобрен от Lovable.
            </p>
          </div>
        </div>
      </div>
    </section>

    <StickyCta />
    <Footer />
  </div>
</Base>

<script>
  // Every "sign up" link lands the visitor in the email field, not just near it.
  document.querySelectorAll('a[href="#zapis"], a[href="/#zapis"]').forEach((link) => {
    link.addEventListener('click', () => {
      const input = document.getElementById('email-hero') as HTMLInputElement | null;
      if (input && !input.closest('form')?.hidden) {
        // Wait for the smooth scroll to arrive before focusing.
        setTimeout(() => input.focus({ preventScroll: true }), 450);
      }
    });
  });
</script>

<style>
  .page {
    background: var(--paper);
    overflow-x: hidden;
  }

  .container {
    max-width: 1180px;
    margin: 0 auto;
  }

  h2 {
    font-size: clamp(30px, 4.4vw, 50px);
    line-height: 1.06;
    letter-spacing: -0.03em;
    font-weight: 800;
    margin: 0;
  }

  .kicker {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 14px;
  }

  .kicker.pink {
    color: var(--pink-soft);
  }

  .section-head {
    max-width: 640px;
    margin-bottom: 52px;
  }

  /* ============ HERO ============ */
  .hero {
    position: relative;
    background: var(--ink);
    color: #fff;
    padding: clamp(56px, 7vw, 96px) 24px clamp(72px, 9vw, 120px);
    overflow: hidden;
  }

  .glow {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }

  .glow-tr {
    top: -160px;
    right: -120px;
    width: 520px;
    height: 520px;
    background: radial-gradient(
      circle at 40% 40%,
      rgba(255, 78, 142, 0.42),
      rgba(124, 92, 255, 0.22) 45%,
      transparent 70%
    );
    filter: blur(20px);
  }

  .glow-bl {
    bottom: -200px;
    left: -140px;
    width: 480px;
    height: 480px;
    background: radial-gradient(circle at 50% 50%, rgba(254, 123, 2, 0.3), transparent 68%);
    filter: blur(24px);
  }

  .hero-grid {
    position: relative;
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 52px;
    align-items: center;
  }

  .live-pill {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 7px 14px 7px 11px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
    font-size: 13.5px;
    font-weight: 600;
    color: #f4e9e0;
    margin-bottom: 26px;
  }

  .live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--orange);
    box-shadow: 0 0 0 4px rgba(254, 123, 2, 0.25);
  }

  h1 {
    font-size: clamp(40px, 6.6vw, 80px);
    line-height: 1.02;
    letter-spacing: -0.035em;
    font-weight: 800;
    margin: 0 0 22px;
  }

  .grad-text {
    background: linear-gradient(115deg, #fe7b02, #ff4e8e 42%, #7c5cff 72%, #4b73ff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-sub {
    font-size: clamp(17px, 2vw, 21px);
    line-height: 1.55;
    color: var(--muted-dark);
    max-width: 520px;
    margin: 0 0 32px;
    font-weight: 400;
  }

  .hero-sub strong {
    color: #fff;
    font-weight: 600;
  }

  .hero-signup {
    max-width: 500px;
  }

  .bonus-line {
    margin: 14px 2px 0;
    color: #f4e9e0;
    font-size: 14px;
  }

  .bonus-line strong {
    color: #fff;
  }

  .fine-print {
    margin: 8px 2px 0;
    color: #8f897c;
