---
import Legal from '../layouts/Legal.astro';
import { siteConfig } from '../config';

// TODO(radoslav): PLACEHOLDER prompts — replace with your real, battle-tested
// Lovable prompts before sharing the link. The welcome email points here.
const prompts = [
  {
    title: 'Лендинг страница за услуга',
    text: 'Създай модерна лендинг страница за [услуга] с тъмна тема, hero секция със силно заглавие, 3 предимства с икони, секция с отзиви и форма за контакт. Използвай [цвят] като акцент.',
  },
  {
    title: 'Вътрешен инструмент с таблица',
    text: 'Направи вътрешен инструмент за екипа ми: таблица с [записи], търсене, филтри по статус, добавяне и редактиране през модален прозорец, и експорт до CSV.',
  },
  {
    title: 'AI чатбот за сайт',
    text: 'Добави чат виджет в долния десен ъгъл, който отговаря на въпроси за [бизнеса] на български. Дай му приветливо посрещащо съобщение и бързи бутони с честите въпроси.',
  },
  {
    title: 'Форма със записване в база данни',
    text: 'Създай форма за [запитване/резервация] с полета [имена на полета], валидация и запис в базата данни. Покажи страница за администратора със списък на подадените заявки.',
  },
  {
    title: 'Дашборд с графики',
    text: 'Направи дашборд с 4 ключови метрики в карти отгоре и 2 графики отдолу — линейна за тенденция по дни и кръгова по категории. Данните са: [описание на данните].',
  },
  {
    title: 'Поправка на дизайн',
    text: 'Прегледай страницата и подобри визуалната йерархия: по-ясни заглавия, повече въздух между секциите, консистентни отстояния и по-добър контраст на бутоните. Не променяй функционалността.',
  },
  {
    title: 'Мобилна версия',
    text: 'Прегледай сайта на мобилен екран и оправи всичко счупено: навигацията да се събира в меню, таблиците да се скролват хоризонтално, текстовете да не преливат.',
  },
  {
    title: 'Многоезичност',
    text: 'Добави превключвател за език (български/английски) в хедъра и преведи целия текст на сайта. Запомняй избора на потребителя.',
  },
  {
    title: 'Свързване с външно API',
    text: 'Свържи приложението с [API], вземи [данни] и ги покажи в [компонент]. Обработи грешките елегантно и покажи състояние на зареждане.',
  },
  {
    title: 'Преди пускане на живо',
    text: 'Прегледай проекта преди публикуване: провери всички линкове, добави мета описания за споделяне в социални мрежи, favicon и страница 404. Кажи ми какво още липсва.',
  },
];
---

<Legal
  title={siteConfig.leadMagnetTitle}
  description="Бонус за записаните в безплатния уебинар: готови промптове, които да копираш директно в Lovable."
  path={siteConfig.leadMagnetPath}
  kicker="🎁 Бонус"
  updated={null}
  noindex
>
  <p>
    Това са промптове, които използвам постоянно. Копирай ги директно в Lovable, замени частите
    в <strong>[скоби]</strong> с твоя контекст и надграждай с последващи съобщения.
  </p>

  {
    prompts.map((p, i) => (
      <>
        <h2>
          {i + 1}. {p.title}
        </h2>
        <p class="prompt-box">{p.text}</p>
      </>
    ))
  }

  <div class="legal-links">
    <a href="/#zapis">← Обратно към курса</a>
  </div>
</Legal>

<style>
  .prompt-box {
    background: #fff;
    border: 1px solid rgba(23, 21, 15, 0.1);
    border-left: 3px solid var(--orange);
    border-radius: 12px;
    padding: 16px 18px;
    font-size: 15.5px;
  }
</style>
